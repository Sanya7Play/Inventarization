// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Role {
    id          Int     @id @default(autoincrement())
    name        String
    description String?

    users User[]

    @@map("roles")
}

model User {
    id        Int      @id @default(autoincrement())
    fullName  String
    email     String   @unique
    phone     String?
    status    String   @default("Активен")
    createdAt DateTime @default(now())

    roleId Int?
    role   Role? @relation(fields: [roleId], references: [id])

    products Inventory[]

    @@map("users")
}

model TypeInventory {
    id          Int     @id @default(autoincrement())
    typeName    String
    description String?

    products Inventory[]

    @@map("types")
}

model Inventory {
    id           Int     @id @default(autoincrement())
    name         String
    inventNumber String?
    img          String?
    serialNumber String?
    expiryDate   String?
    status       String  @default("На складе")

    userId Int?
    user   User? @relation(fields: [userId], references: [id])

    typeId Int?
    type   TypeInventory? @relation(fields: [typeId], references: [id])

    @@map("inventory")
}

model Order {
    id             Int     @id @default(autoincrement())
    purchaseNumber String
    supplier       String?
    expireDate     String?
    positionNumber Int?
    sum            Float?
    status         String  @default("В обработке")

    @@map("orders")
}

model Supplier {
    id            Int     @id @default(autoincrement())
    companyName   String
    contactPerson String?
    contactNumber String?
    email         String?
    contractType  String?
    contractDate  String?

    @@map("suppliers")
}

model Backup {
    id        Int      @id @default(autoincrement())
    name      String
    createdAt DateTime @default(now())
    size      String?
    type      String?
    data      Json

    @@map("backups")
}
